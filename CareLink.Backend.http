@CareLink.Backend_HostAddress = http://localhost:5277

GET {{CareLink.Backend_HostAddress}}/
Accept: application/json

### Communications Overview
GET {{CareLink.Backend_HostAddress}}/api/communications/overview
Accept: application/json

### Audiences
GET {{CareLink.Backend_HostAddress}}/api/communications/audiences
Accept: application/json

### Channel Health
GET {{CareLink.Backend_HostAddress}}/api/communications/channel-health
Accept: application/json

### Get Broadcasts
GET {{CareLink.Backend_HostAddress}}/api/communications/broadcasts
Accept: application/json

### Get Broadcast by ID
GET {{CareLink.Backend_HostAddress}}/api/communications/broadcasts/BRD-001
Accept: application/json

### Create Broadcast
POST {{CareLink.Backend_HostAddress}}/api/communications/broadcasts
Content-Type: application/json

{
  "title": "Field Safety Briefing - Morning Shift",
  "audience": "North Ward volunteers",
  "message": "Please ensure protective boots and high-vis vests are equipped before sector patrol.",
  "channels": ["In-app", "SMS"]
}

### Resend Broadcast
POST {{CareLink.Backend_HostAddress}}/api/communications/broadcasts/BRD-001/resend
Accept: application/json

### Delete Broadcast
DELETE {{CareLink.Backend_HostAddress}}/api/communications/broadcasts/BRD-001
Accept: application/json

### Get Draft
GET {{CareLink.Backend_HostAddress}}/api/communications/draft
Accept: application/json

