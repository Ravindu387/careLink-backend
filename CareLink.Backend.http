### Volunteer Settings - Get
GET {{CareLink.Backend_HostAddress}}/api/volunteer/settings
Accept: application/json

### Volunteer Settings - Update
PUT {{CareLink.Backend_HostAddress}}/api/volunteer/settings
Content-Type: application/json

{
  "profile": {
    "fullName": "Nadia Okafor",
    "email": "nadia@reliefos.org",
    "phone": "+94 77 412 8041",
    "area": "Greater Riverton"
  },
  "matchingRules": {
    "minimumScore": "75",
    "travelDistance": "30",
    "availability": true,
    "verifiedSkills": true,
    "experience": true,
    "training": true,
    "preventConflicts": true,
    "humanApproval": true
  },
  "notificationSettings": {
    "assignments": true,
    "verification": true,
    "safety": true,
    "aiMatching": true,
    "communications": true,
    "inApp": true,
    "email": true,
    "sms": false,
    "urgentOnly": false
  },
  "security": {
    "twoFactor": true
  }
}

### Volunteer Settings - Change Password
POST {{CareLink.Backend_HostAddress}}/api/volunteer/settings/change-password
Content-Type: application/json

{
  "currentPassword": "oldPassword123",
  "newPassword": "newSecurePassword456!",
  "confirmPassword": "newSecurePassword456!"
}

