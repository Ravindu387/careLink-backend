POST {{CareLink.Backend_HostAddress}}/api/communications/draft
Content-Type: application/json

{
  "title": "Evacuation Route Update",
  "audience": "All active volunteers",
  "message": "Route 4 bridge closed. Reroute via Bypass 12.",
  "channels": ["In-app"]
}

