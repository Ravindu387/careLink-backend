<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d67494ae-8e76-4d56-865c-56b0e66af492</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CareLink.Core\CareLink.Core.csproj" />
    <ProjectReference Include="..\CareLink.Application\CareLink.Application.csproj" />
    <ProjectReference Include="..\CareLink.Infrastructure\CareLink.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Controllers\**\*.cs" LinkBase="CaseVolunteerControllers" />
    <Compile Include="..\Services\**\*.cs" LinkBase="CaseVolunteerServices" />
    <Compile Include="..\Models\**\*.cs" LinkBase="CaseVolunteerModels" />
  </ItemGroup>

</Project>
